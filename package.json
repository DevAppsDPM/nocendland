{
  "name": "nocendland",
  "version": "0.1.14",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "22.x",
    "pnpm": "10.33.2"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/check-style-tokens.mjs && ng build --configuration=production",
    "check:styles": "node scripts/check-style-tokens.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate-types": "pnpm exec supabase gen types typescript --project-id hzwxzvupsctlyrqcdofi > ./src/app/platform/supabase/database.types.ts",
    "security:audit": "pnpm audit --audit-level high",
    "security:builds": "pnpm ignored-builds"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.0.6",
    "@angular/common": "22.0.8",
    "@angular/compiler": "22.0.8",
    "@angular/core": "22.0.8",
    "@angular/forms": "22.0.8",
    "@angular/platform-browser": "22.0.8",
    "@angular/platform-browser-dynamic": "22.0.8",
    "@angular/router": "22.0.8",
    "@angular/service-worker": "22.0.8",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@supabase/storage-js": "2.111.0",
    "@supabase/supabase-js": "2.111.0",
    "chart.js": "^4.3.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "ng2-charts": "10.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/schematics-cli": "22.0.8",
    "@angular/build": "22.0.8",
    "@angular/cli": "22.0.8",
    "@angular/compiler-cli": "22.0.8",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "supabase": "2.110.0",
    "tailwindcss": "^3.4.13",
    "typescript": "6.0.3"
  }
}
